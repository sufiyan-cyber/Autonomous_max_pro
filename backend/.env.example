# --- Memory backend: cloud | local | mock ---------------------------------
# cloud = Cognee Cloud (hackathon track). Get tenant URL + API key at
#         https://platform.cognee.ai -> API Keys
# local = self-hosted cognee (needs LLM_API_KEY below for cognee's pipeline)
# mock  = no keys needed; keyword-recall dev mode for UI work
MEMORY_BACKEND=mock

COGNEE_CLOUD_URL=https://your-tenant.aws.cognee.ai
COGNEE_CLOUD_API_KEY=

# --- NPC dialogue (Claude) --------------------------------------------------
ANTHROPIC_API_KEY=
ALIBI_MODEL=claude-opus-4-8

# --- Only for MEMORY_BACKEND=local (cognee's own pipeline LLM) --------------
# LLM_API_KEY=
